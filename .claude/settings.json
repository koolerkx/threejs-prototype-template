{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(yarn typecheck)",
      "Bash(yarn build)",
      "Bash(yarn check)",
      "Bash(yarn shot:*)",
      "Bash(yarn new:*)",
      "Bash(yarn dev:*)",
      "Bash(node scripts/shot.mjs:*)",
      "Bash(node scripts/new-experiment.mjs:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Read(.shots/**)",
      "WebFetch(domain:threejs.org)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:raw.githubusercontent.com)",
      "WebFetch(domain:dev.epicgames.com)",
      "WebFetch(domain:docs.unity3d.com)",
      "WebFetch(domain:docs.godotengine.org)"
    ]
  }
}
